{
  "schemaVersion": 1,
  "id": "optileaves",
  "version": "${version}",
  "name": "OptiLeaves",
  "description": "Rendering optimization mod for MC with configurable leaf culling.",
  "authors": [
    "norevy"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.norevy.optileaves.OptiLeavesClient"
    ],
    "modmenu": [
      "net.norevy.optileaves.ui.MenuHook"
    ]
  },
  "mixins": [
    "optileaves.mixins.json",
    "optileaves.sodium.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*",
    "sodium": "*"
  },
